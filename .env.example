# ==============================================================================
# Unified Configuration (.env)
# 
# Variables use the TF_VAR_ prefix so Terraform automatically maps them to
# variables in variables.tf (e.g., TF_VAR_project_id -> var.project_id),
# and the Python application / local test runner also reads them seamlessly.
# ==============================================================================

# Google Cloud Platform
TF_VAR_project_id="test"
TF_VAR_region="europe-west1"
TF_VAR_time_zone="Europe/Warsaw"

# Telegram Bot Credentials
TF_VAR_telegram_bot_token="123:dghgh"
TF_VAR_telegram_chat_id="test"

# OpenAI API Key
TF_VAR_openai_api_key="sk-..."

# ElevenLabs TTS Configuration
TF_VAR_elevenlabs_api_key="elevenlabs-api-key"
TF_VAR_elevenlabs_voice_id="pNInz6obpgDQGcFmaJgB"
